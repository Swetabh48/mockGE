generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Paper {
  id           String     @id @default(cuid())
  title        String
  tier         String
  source       String     @default("seed")
  difficulty   String     @default("hard")
  mode           String     @default("full_mock")
  focusSection   String?
  focusTopic     String?
  focusSubtopic  String?
  createdAt      DateTime   @default(now())
  questions      Question[]
  attempts       Attempt[]
  destPassage    String?
}

model Question {
  id            String   @id @default(cuid())
  paperId       String
  paper         Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  qIndex        Int
  sectionKey    String
  subject       String
  topic         String
  subtopic      String?
  difficulty    String   @default("medium")
  stemEn        String
  stemHi        String?
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String?
  trick         String?
  marks         Float    @default(2)
  negativeMarks Float    @default(0.5)
  source        String   @default("seed")

  @@index([paperId, qIndex])
  @@index([paperId, sectionKey])
  @@index([subject, topic])
}

model Attempt {
  id              String        @id @default(cuid())
  paperId         String
  paper           Paper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  tier            String
  status          String        @default("in_progress")
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  currentSection  String?
  score           Float?
  maxScore        Float?
  correctCount    Int?
  wrongCount      Int?
  unattempted     Int?
  analysisJson    String?
  destQualified   Boolean?
  destAccuracy    Float?
  destKeystrokes  Int?
  answers         AnswerEvent[]
}

model AnswerEvent {
  id           String   @id @default(cuid())
  attemptId    String
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String
  selected     String?
  markedReview Boolean  @default(false)
  visited      Boolean  @default(false)
  timeSpentMs  Int      @default(0)
  changeCount  Int      @default(0)
  firstViewAt  DateTime?
  lastChangeAt DateTime?

  @@unique([attemptId, questionId])
  @@index([attemptId])
}
