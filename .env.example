# Copy to .env and set your Postgres URL (Prisma Postgres / Neon / etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Local question model (Ollama). Practice generation uses this when reachable.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="mockge-ssc"
# Production: set OLLAMA_BASE_URL to your Modal HTTPS URL (modal deploy infra/serve_mockge_ollama.py)
# OLLAMA_API_KEY=""
